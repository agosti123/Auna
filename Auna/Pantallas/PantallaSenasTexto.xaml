<UserControl x:Class="Auna.Pantallas.PantallaSenasTexto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="600">

	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<Grid Margin="28">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Título y explicación -->
			<StackPanel Grid.Row="0" Margin="0,0,0,20">
				<TextBlock Text="Señas → Texto"
                           Style="{StaticResource Titulo}"/>

				<TextBlock Text="Mostrá una seña frente a la cámara para obtener una interpretación en texto."
                           Style="{StaticResource Texto}"/>
			</StackPanel>


			<!-- Estado de la cámara y botón para abrirla -->
			<StackPanel Grid.Row="1" Margin="0,0,0,16">

				<Border Padding="14"
						Margin="0,0,0,12"
						CornerRadius="8"
						Background="{StaticResource ColorAcentoSuave}">

					<TextBlock x:Name="TextoEstadoCamara"
							   Text="Cámara cerrada"
							   Style="{StaticResource Texto}"/>
				</Border>

				<Button x:Name="BotonAbrirCamara"
						Content="Abrir cámara"
						Style="{StaticResource BotonPrincipal}"
						HorizontalAlignment="Left"
						Click="AlAbrirCamara"/>
			</StackPanel>


			<!-- Resultado reconocido -->
			<Border Grid.Row="2"
                    Padding="24"
                    Margin="0,0,0,20"
                    CornerRadius="10"
                    BorderBrush="{StaticResource ColorBorde}"
                    BorderThickness="1"
                    Background="White">
				<StackPanel>
					<TextBlock Text="Resultado"
                               Style="{StaticResource Texto}"/>

					<TextBlock x:Name="TextoResultado"
                               Text="Todavía no hay una seña reconocida"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorAcento}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
				</StackPanel>
			</Border>

			<!-- Sugerencias y acciones -->
			<StackPanel Grid.Row="3">
				<TextBlock Text="¿Era esto lo que quisiste decir?"
                           Style="{StaticResource Texto}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

				<TextBlock x:Name="TextoSugerencias"
                           Text="Las sugerencias aparecerán aquí."
                           Style="{StaticResource Texto}"
                           Margin="0,0,0,8"/>

				<!-- Botones con las opciones cuando la cámara no está segura (tarea C2) -->
				<WrapPanel x:Name="PanelSugerencias" Margin="0,0,0,16"/>

				<WrapPanel>
					<Button Content="No entendí"
                            Style="{StaticResource Boton}"
                            Margin="8,0,0,0"
                            Click="AlNoEntender"/>

					<Button Content="Escuchar"
                            Style="{StaticResource Boton}"
                            Margin="8,0,0,0"
                            Click="AlEscuchar"/>
				</WrapPanel>

				<TextBlock x:Name="TextoMensaje"
                           Style="{StaticResource Texto}"
                           Margin="0,16,0,0"/>
			</StackPanel>
		</Grid>
	</ScrollViewer>
</UserControl>
