<UserControl x:Class="Auna.Pantallas.PantallaEnConstruccion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Auna">
    <!-- Pantalla provisoria. Cada integrante la reemplaza por la suya
         (ver CrearPantallas() en MainWindow.xaml.cs). -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="TextoTitulo" Style="{StaticResource Titulo}" HorizontalAlignment="Center" />
        <TextBlock x:Name="TextoAviso" Style="{StaticResource Texto}" HorizontalAlignment="Center" Margin="0,0,0,24" />
        <Button Content="Volver al inicio (Esc)" Style="{StaticResource Boton}" HorizontalAlignment="Center"
                Command="{x:Static local:Comandos.IrInicio}" />
    </StackPanel>
</UserControl>
