<UserControl x:Class="Auna.Pantallas.PantallaTextoSenas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gif="http://wpfanimatedgif.codeplex.com">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Texto → Señas" Style="{StaticResource Titulo}"/>

        <DockPanel Grid.Row="1" Margin="0,20,0,20">
            <Button DockPanel.Dock="Right" Content="Mostrar" IsDefault="True"
                    Style="{StaticResource BotonPrincipal}" Margin="10,0,0,0"
                    Click="Mostrar_Click"/>
            <Button DockPanel.Dock="Right" Content="Escuchar"
                    Style="{StaticResource Boton}" Margin="10,0,0,0"
                    ToolTip="Lee la palabra en voz alta"
                    AutomationProperties.Name="Escuchar la palabra en voz alta"
                    Click="Escuchar_Click"/>
            <TextBox x:Name="CuadroTexto" FontSize="18" Padding="8"
                     AutomationProperties.Name="Palabra a traducir"/>
        </DockPanel>

        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1" Background="White">
            <Image x:Name="Personaje" Stretch="Uniform"
                   AutomationProperties.Name="Personaje que muestra la seña"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="BotonPausa" Content="Pausa" Style="{StaticResource Boton}"
                    Margin="0,0,10,0" Click="Pausa_Click"/>
            <Button Content="Repetir" Style="{StaticResource Boton}"
                    Margin="0,0,10,0" Click="Repetir_Click"/>
            <Button Content="Más lento" Style="{StaticResource Boton}"
                    Click="MasLento_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
    